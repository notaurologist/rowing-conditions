# Copy to .env for local development. pnpm dev loads it if present. Never commit .env.
DATABASE_URL=postgres://rowing:rowing@localhost:5432/rowing
# NWS requires a User-Agent naming the app and a contact; requests without one get 403.
NWS_USER_AGENT=rowing-conditions (you@example.com)
# Optional. Leave unset unless you have a key: USGS rejects an invalid key with 403.
# USGS_API_KEY=
# PORT=3000
